VITE_MODE=sandbox
VITE_NETWORK=testnet
VITE_RPC_URL=https://rpc.testnet.near.org
VITE_CONTRACT_ID=night.we-inherit-night.testnet
VITE_VIEW_ACCOUNT_ID=
# Connector selected for future integration; no wallet/signing code in M1.
VITE_WALLET_CONNECTOR=near-connect
# Preserved Pass 2B server-only adapter settings; never use VITE_ for secrets.
# Pass 2C gameplay ignores these and always uses deterministic policies. Keep disabled.
NIGHT_LLM_ENABLED=0
NIGHT_LLM_MODEL=
OPENAI_API_KEY=
# Optional separate local preview save (runner setting, not a browser variable).
# NIGHT_SAVE_DIR=.local/pass2b-preview

# Public on-chain world identifier (required for multi-campaign Testnet views).
VITE_CAMPAIGN_ID=

# Opt-in local walletless backend; build with VITE_MODE=testnet.
# Default remains the existing read-only Testnet adapter.
VITE_TESTNET_BACKEND=0
# Server-only JSON configuration path; never contains private keys.
# NIGHT_SERVER_CONFIG=.local/testnet-server.json

# Render deployment (server-only, configure in protected Environment editor).
# See docs/PASS4E.md and docs/render-config.example.json.
# NODE_VERSION=24.13.0
# NODE_ENV=production
# NIGHT_DATA_DIR=/var/data/night
# NIGHT_CONFIG_JSON=<public server configuration JSON>
# NIGHT_RUNTIME_KEYS=<restricted runtime credential array; never commit values>
# NIGHT_ORIGIN=https://your-approved-domain.example
# Render supplies PORT, RENDER and RENDER_EXTERNAL_URL.
# Build with VITE_MODE=testnet and VITE_TESTNET_BACKEND=1.
